# Google Custom Search API Configuration
# Get your API Key: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=your_google_api_key_here

# Get your Search Engine ID: https://cse.google.com/cse/all
# Make sure to enable "Search the entire web" in your CSE settings
GOOGLE_CSE_ID=your_cse_id_here

# Optional: Bing Search API (if you prefer to implement it later)
# BING_API_KEY=your_bing_api_key_here
