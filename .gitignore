# Keep documentation and configs
!output/*.md
!output/README.md

# OSM Data files (keep structure, exclude large data)
omsData/*.geojson
omsData/*.osm.pbf
omsData/*.pbf

# User uploads directory (exclude all uploaded files)
output/uploads/

# Deno
deno.lock

