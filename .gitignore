/migration-log-*.log
/migration-results-*.json

# SRTM elevation cache (binary HGT tiles, downloaded on demand)
data/srtm-cache/

# Dado pessoal de terceiros e material de prospecção NÃO entram neste repo.
# Lugar deles é ../Tuggi-negocio/, fora do alcance dos agentes (CLAUDE.md).
# Os CSVs do Cadastur trazem CPF e telefone de pessoa física; Connections.csv
# é exportação de contatos. Uma vez no histórico do git, só saem reescrevendo-o.
data/*.csv
linkedin/

# Ad-hoc investigation/migration scripts (not part of core pipeline)
scripts/probe-nominatim-stuck-pois.ts
scripts/recover-cities-proximity.ts
scripts/test-enrichment-fallback-fix.ts
scripts/test-enrichment-via-cache.ts

# One-off reports
lost_pois_report.md
installed_apps.txt


# Local DB clone dumps (contains secrets, large dumps) — never commit
db-clone/

# Memória dos agentes vive no workspace (../.claude/agent-memory/), não no repo do projeto.
.claude/agent-memory/
.claude/settings.local.json

# Backups locais dos scripts de curadoria (merge/dedupe/demote) — dados, não código
.dedupe-out/
.merge-out/
.demote-out/

# Credenciais das contas de teste do CARD-CMS-01 (scripts/qa) — nunca commitar senha, mesmo de
# conta de teste em domínio fake.
scripts/qa/*.local.json
.vercel
.env*

# Canvas de design: as fontes .dc.html sao versionadas, o HTML sempre e regerado
# a partir delas pelo seed do skill e carrega ~2,5 MB do editor embutido.
design/*.html
!design/*.dc.html
