# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key_here
SUPABASE_SECRET_KEY=your_sb_secret_key_here
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=your_storage_bucket_key_here

# Google Services API Keys
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
GOOGLE_TTS_PROJECT_ID=your_google_project_id_here

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Marketing — Newsletter (Resend). Estes são secrets das Edge Functions
# (send-newsletter, resend-webhook), não do Next — configure no painel Supabase.
# - RESEND_FROM deve usar o subdomínio verificado na Resend (ex.: updates.tuggi.app)
# - APP_URL aponta para o SITE público que hospeda /unsubscribe (tuggi-enterprise),
#   NÃO para o CMS (mantém cms.tuggi.app privado).
# - NEWSLETTER_SECRET é compartilhado entre a EF (assina o link) e o site
#   (verifica em /[locale]/unsubscribe) — use o MESMO valor nos dois.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Tuggi <news@updates.tuggi.app>
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
APP_URL=https://www.tuggi.app
NEWSLETTER_SECRET=your_long_random_shared_secret_here

# Formulário público de parceria (#341)
# - PARTNER_FORM_HASH_SECRET é o segredo do servidor que entra no HMAC do endereço de quem
#   envia (core.partner_form_attempts.client_hash). SEM ELE O FORMULÁRIO RECUSA A SUBMISSÃO —
#   de propósito: hash de IP sem segredo é força-brutável, e voltar a gravar assim em silêncio
#   seria pior que não ter segredo nenhum. Valor longo e aleatório, só no servidor.
#   Trocá-lo re-chaveia o contador e custa, no máximo, uma janela de contagem (1 hora).
PARTNER_FORM_HASH_SECRET=your_long_random_server_secret_here

# Security Notes:
# - Never commit the actual .env file to version control
# - Use strong, unique API keys for production
# - Regularly rotate API keys
# - Restrict API key permissions to minimum required scope