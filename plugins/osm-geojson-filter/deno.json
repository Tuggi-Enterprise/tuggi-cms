{
  "name": "osm-geojson-filter",
  "version": "1.0.0",
  "description": "A standalone Deno plugin for filtering large OpenStreetMap GeoJSON files",
  "main": "filter-geojson.ts",
  "scripts": {
    "preview": "deno run --allow-read --allow-write filter-geojson.ts preview",
    "analyze": "deno run --allow-read --allow-write filter-geojson.ts analyze",
    "filter": "deno run --allow-read --allow-write filter-geojson.ts filter",
    "config": "deno run --allow-read --allow-write filter-geojson.ts config"
  },
  "imports": {
    "@std/": "https://deno.land/std@0.208.0/",
    "@std/path": "https://deno.land/std@0.208.0/path/mod.ts",
    "@std/fs": "https://deno.land/std@0.208.0/fs/mod.ts",
    "@std/io": "https://deno.land/std@0.208.0/io/mod.ts",
    "@std/json": "https://deno.land/std@0.208.0/json/mod.ts"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "include": ["**/*.ts"],
    "exclude": ["output/", "config/"]
  }
}

