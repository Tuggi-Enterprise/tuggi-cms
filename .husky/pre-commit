#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Verificando erros de TypeScript e ESLint..."

# Verificar TypeScript
npm run type-check:app
if [ $? -ne 0 ]; then
  echo "❌ Erros de TypeScript encontrados. Commit cancelado."
  exit 1
fi

# Verificar ESLint
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Erros de ESLint encontrados. Commit cancelado."
  exit 1
fi

echo "✅ Todas as verificações passaram!"
